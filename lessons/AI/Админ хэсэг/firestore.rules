rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Админ = зөвхөн энэ UID-тай хэрэглэгч (Firebase → Authentication → Users-ээс хуул)
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['ЭНД_UID'];
    }

    match /leads/{id} {
      // Хэн ч шинэ захиалга ҮҮСГЭЖ болно (Service захиалга хичээлийнхтэй ижил)
      allow create: if request.resource.data.keys().hasOnly(['name', 'contact', 'service', 'message', 'createdAt'])
        && request.resource.data.name is string    && request.resource.data.name.size() > 0    && request.resource.data.name.size() <= 100
        && request.resource.data.contact is string && request.resource.data.contact.size() > 0 && request.resource.data.contact.size() <= 100
        && request.resource.data.service is string && request.resource.data.service.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.createdAt == request.time;

      // Зөвхөн админ уншина
      allow read: if isAdmin();

      // Админ зөвхөн status-ийг өөрчилнө
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'contacted', 'confirmed', 'done', 'cancelled'];

      // Устгахгүй — түүх үлдэнэ (cancelled болгоно)
      allow delete: if false;

      // Дотоод тэмдэглэл: нэмж болно, засаж/устгаж болохгүй (түүх)
      match /notes/{noteId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['text', 'author', 'createdAt'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.author == request.auth.token.email
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
